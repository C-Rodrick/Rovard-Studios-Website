{
  "name": "rovard-studios-website",
  "private": true,
  "version": "3.0.0",
  "description": "ROVARD STUDIOS website. Static pages generated by tools/build.py; JS and CSS bundled by tools/bundle.mjs.",
  "type": "module",
  "scripts": {
    "bundle": "node tools/bundle.mjs",
    "pages": "python tools/build.py",
    "build": "node tools/bundle.mjs && python tools/build.py",
    "watch": "node tools/bundle.mjs --watch",
    "serve": "python -m http.server 8000"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
