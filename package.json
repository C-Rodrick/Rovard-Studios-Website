{
  "name": "rovard-studios-obsidian",
  "private": true,
  "version": "4.0.0",
  "description": "ROVARD STUDIOS, Obsidian Architecture direction. Static pages generated by tools/oa/build.py; JS and CSS bundled by tools/oa/bundle.mjs.",
  "type": "module",
  "scripts": {
    "bundle": "node tools/oa/bundle.mjs",
    "pages": "python tools/oa/build.py",
    "stills": "python tools/oa/stills.py",
    "build": "node tools/oa/bundle.mjs && python tools/oa/build.py",
    "test": "python tools/oa/test_site.py",
    "serve": "python -m http.server 8000"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
